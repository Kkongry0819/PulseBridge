<Window x:Class="PulseBridge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PulseBridge · 心率工作台" Icon="Assets/PulseBridge.ico" Width="1340" Height="960" MinWidth="1060" MinHeight="700" Background="#130F1B" Foreground="#F6F0F8" FontFamily="Segoe UI, Microsoft YaHei UI" WindowStartupLocation="CenterScreen">
 <Grid x:Name="AppRoot" TextOptions.TextRenderingMode="Grayscale" UseLayoutRounding="True">
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#211525"/><GradientStop Color="#15111E" Offset=".5"/><GradientStop Color="#14191F" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#18131F" BorderBrush="#352739" BorderThickness="0,0,1,0">
   <Grid Margin="18,29,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <StackPanel Orientation="Horizontal" Margin="5,0,0,0"><Image Source="{StaticResource BrandMark}" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Margin="10,1,0,0"><TextBlock Text="PulseBridge" FontSize="19" FontWeight="SemiBold" Foreground="#FFF0F6"/><TextBlock Text="HEART RATE STUDIO" FontSize="8" Foreground="#AD8DA6" Margin="1,4,0,0"/></StackPanel></StackPanel>
     <TextBlock Text="让每一次心跳被看见" FontSize="11" Foreground="#9C8AA5" Margin="7,17,0,30"/>
     <TextBlock Text="工作空间" FontSize="10" Foreground="#82718D" Margin="14,0,0,9"/>
     <RadioButton x:Name="OverviewNav" AutomationProperties.Name="心率工作台" Style="{StaticResource NavButton}" IsChecked="True" Click="Overview_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource DashboardIcon}" Width="17" Height="17" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/><TextBlock Text="心率工作台" FontSize="12"/></StackPanel></RadioButton>
     <RadioButton x:Name="DevicesNav" AutomationProperties.Name="连接设备" Style="{StaticResource NavButton}" Click="Devices_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource DeviceIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Margin="0,0,12,0"/><TextBlock Text="连接设备" FontSize="12"/></StackPanel></RadioButton>
     <RadioButton x:Name="SyncNav" AutomationProperties.Name="状态同步" Style="{StaticResource NavButton}" Click="Sync_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource SyncIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Margin="0,0,12,0"/><TextBlock Text="状态同步" FontSize="12"/></StackPanel></RadioButton>
     <Border Height="1" Background="#302436" Margin="12,20,12,16"/>
     <Button AutomationProperties.Name="设备接入指南" Click="Guide_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Foreground="#B4A2BF"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource GuideIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="#B4A2BF" StrokeThickness="1.5" Margin="0,0,12,0"/><TextBlock Text="设备接入指南" FontSize="12"/></StackPanel></Button>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <CheckBox x:Name="MotionBox" Content="界面动效" IsChecked="True" Checked="Motion_Changed" Unchecked="Motion_Changed" Margin="12,0,0,18" ToolTip="控制心跳、入场、图表及悬停动画；同时遵循 Windows 动画设置。"/>
     <Border Background="#201E29" BorderBrush="#344339" BorderThickness="1" CornerRadius="12" Padding="13,14"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Fill="#92DDC3" Width="6" Height="6" Margin="0,0,7,0"/><TextBlock Text="LOCAL FIRST" Foreground="#9CDFCA" FontSize="10" FontWeight="SemiBold"/></StackPanel><TextBlock Text="会话记录保存在本机" Foreground="#A196AD" FontSize="10" Margin="0,8,0,0"/><TextBlock Text="你的节奏，由你掌握。" Foreground="#786C86" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border>
     <TextBlock Text="PULSEBRIDGE   /   v1.1" FontSize="9" Foreground="#8E7896" Margin="9,17,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <ScrollViewer x:Name="MainScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
   <StackPanel x:Name="MainContent" Margin="30,28,30,20">
    <Grid x:Name="Header" Margin="0,0,0,25"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><StackPanel Orientation="Horizontal"><Border Width="21" Height="2" Background="#F793B9" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="YOUR HEART. CONNECTED." Foreground="#D2A6BF" FontSize="9" FontWeight="SemiBold"/></StackPanel><TextBlock Text="每一次心跳，都有回响。" FontSize="28" FontWeight="SemiBold" Margin="0,9,0,7"/><TextBlock Text="连接你的设备，让真实心率融入虚拟世界。" Foreground="#A79AB2" FontSize="12"/></StackPanel>
     <Border Grid.Column="1" CornerRadius="17" Background="#27202F" BorderBrush="#43324B" BorderThickness="1" Padding="14,9" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock x:Name="TopStatus" Text="○  未连接设备" Foreground="#C5BDCC" FontSize="11"/></Border>
    </Grid>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="336"/></Grid.ColumnDefinitions>
     <StackPanel>
      <Border x:Name="HeartCard" Style="{StaticResource Card}" Padding="23,20" ClipToBounds="True" BorderBrush="#644057">
       <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3E243B"/><GradientStop Color="#291E32" Offset=".6"/><GradientStop Color="#24202E" Offset="1"/></LinearGradientBrush></Border.Background>
       <Grid>
        <Canvas IsHitTestVisible="False" ClipToBounds="True"><Ellipse Width="205" Height="205" Stroke="#27DC86B2" StrokeThickness="1" Canvas.Right="-85" Canvas.Top="-95"/><Ellipse Width="155" Height="155" Stroke="#22DC86B2" StrokeThickness="1" Canvas.Right="-60" Canvas.Top="-70"/></Canvas>
        <StackPanel>
         <Grid><TextBlock Text="实时心率" Foreground="#DFBCD3" FontSize="12"/><Border HorizontalAlignment="Right" Background="#352737" CornerRadius="5" Padding="7,4"><TextBlock x:Name="LiveBadge" Text="WAITING / 等待" Foreground="#BAA1BB" FontSize="9"/></Border></Grid>
         <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid Width="60" Height="66" VerticalAlignment="Center" Margin="0,0,10,0">
           <Ellipse x:Name="HeartHalo" Stroke="#F999BE" StrokeThickness="1" Opacity="0" Width="54" Height="54" RenderTransformOrigin=".5,.5"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
           <Path x:Name="HeartIcon" Data="{StaticResource HeartGeometry}" Width="42" Height="42" Stretch="Uniform" Fill="{StaticResource AccentGradient}" RenderTransformOrigin=".5,.5"><Path.RenderTransform><ScaleTransform/></Path.RenderTransform><Path.Effect><DropShadowEffect Color="#EA7BA6" BlurRadius="20" ShadowDepth="0" Opacity=".24"/></Path.Effect></Path>
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="BpmText" Text="--" FontSize="84" FontWeight="Light" FontFamily="Segoe UI" Foreground="#FFF1F8" RenderTransformOrigin=".5,.5"><TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform></TextBlock><StackPanel VerticalAlignment="Bottom" Margin="12,0,0,22"><TextBlock Text="BPM" Foreground="#F7C7DD" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="次 / 分钟" Foreground="#B291AD" FontSize="9" Margin="0,5,0,0"/></StackPanel></StackPanel>
         </Grid>
         <TextBlock x:Name="DataStatus" Text="等待设备连接，或使用演示模式预览界面" Foreground="#BAA5C0" FontSize="10" Margin="0,0,0,17" TextWrapping="Wrap"/>
         <Border Background="#402B42" BorderBrush="#62415C" BorderThickness="1" CornerRadius="8" Padding="11,9"><TextBlock x:Name="SourceLabel" Text="⌁  尚未接收心率数据" Foreground="#FBC1D7" FontSize="11"/></Border>
        </StackPanel>
       </Grid>
      </Border>
      <Grid x:Name="StatsRow" Margin="0,13,0,13"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="会话平均" Foreground="{StaticResource Muted}" FontSize="10"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock x:Name="AvgText" Text="--" FontSize="25" FontWeight="Medium"/><TextBlock Text="bpm" Foreground="#8E809C" FontSize="9" VerticalAlignment="Bottom" Margin="5,0,0,5"/></StackPanel><Border Width="18" Height="2" Background="#B8A3D8" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="最低心率" Foreground="{StaticResource Muted}" FontSize="10"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock x:Name="MinText" Text="--" FontSize="25" Foreground="#9DE2D0" FontWeight="Medium"/><TextBlock Text="bpm" Foreground="#8E809C" FontSize="9" VerticalAlignment="Bottom" Margin="5,0,0,5"/></StackPanel><Border Width="18" Height="2" Background="#91DEC8" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border>
       <Border Grid.Column="4" Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="最高心率" Foreground="{StaticResource Muted}" FontSize="10"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock x:Name="MaxText" Text="--" FontSize="25" Foreground="#FFACCD" FontWeight="Medium"/><TextBlock Text="bpm" Foreground="#8E809C" FontSize="9" VerticalAlignment="Bottom" Margin="5,0,0,5"/></StackPanel><Border Width="18" Height="2" Background="#F69BBC" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border>
      </Grid>
      <Border x:Name="TrendCard" Style="{StaticResource Card}" Padding="20,18">
       <StackPanel><Grid><TextBlock Text="心率趋势" FontWeight="SemiBold" FontSize="13"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Fill="#EE9ABD" Width="5" Height="5" Margin="0,0,6,0"/><TextBlock Text="最近 60 秒" Foreground="{StaticResource Muted}" FontSize="9"/></StackPanel></Grid><Canvas x:Name="Chart" Height="125" Margin="0,17,0,6" ClipToBounds="True" SizeChanged="Chart_SizeChanged"/><Grid><TextBlock Text="−60s" Foreground="#9A87A6" FontSize="9"/><TextBlock Text="现在" Foreground="#9A87A6" FontSize="9" HorizontalAlignment="Right"/></Grid></StackPanel>
      </Border>
     </StackPanel>
     <Border Grid.Column="2" x:Name="DeviceCard" Style="{StaticResource Card}" Padding="21,20" VerticalAlignment="Stretch">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel>
        <Grid><StackPanel Orientation="Horizontal"><Border Width="29" Height="29" Background="#382C42" CornerRadius="8" Margin="0,0,10,0"><Path Data="{StaticResource DeviceIcon}" Stroke="#D6B3CE" StrokeThickness="1.5" Width="17" Height="19" Stretch="Uniform"/></Border><TextBlock Text="连接设备" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="01 / INPUT" Foreground="#9A829F" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        <TextBlock Text="选择适合你的心率数据来源" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,17"/>
        <ComboBox x:Name="ProviderBox" SelectionChanged="Provider_Changed" AutomationProperties.Name="心率数据来源"><ComboBoxItem Content="Pulsoid 云端"/><ComboBoxItem Content="蓝牙 BLE 直连"/><ComboBoxItem Content="本地 HTTP 桥接"/><ComboBoxItem Content="演示模式"/></ComboBox>
        <TextBlock x:Name="ProviderHelp" TextWrapping="Wrap" Foreground="#B5A8BF" FontSize="11" LineHeight="19" Margin="0,12,0,16"/>
        <StackPanel x:Name="PulsoidPanel"><TextBlock Text="Pulsoid Access Token" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><PasswordBox x:Name="TokenBox" AutomationProperties.Name="Pulsoid Access Token"/><Button Content="获取 Token ↗" Click="Token_Click" Background="Transparent" BorderThickness="0" Foreground="#F5ACCB" HorizontalAlignment="Left" Padding="0,11"/><TextBlock Text="仅保留在本次运行的内存中。手动 Token 可能需要 BRO 订阅或试用。" TextWrapping="Wrap" Foreground="#9F8BAB" FontSize="10" LineHeight="17"/></StackPanel>
        <StackPanel x:Name="BlePanel" Visibility="Collapsed"><Button x:Name="ScanButton" Content="扫描附近蓝牙设备" Click="Scan_Click"/><ListBox x:Name="DeviceList" Height="106" Margin="0,10,0,0" Background="#14121B" Foreground="#DAD3E4" BorderBrush="#45334E" FontSize="11" DisplayMemberPath="Label" AutomationProperties.Name="附近蓝牙设备"/><TextBlock Text="优先选择标有「心率广播」的设备。" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,8,0,0"/></StackPanel>
        <StackPanel x:Name="HttpPanel" Visibility="Collapsed"><Border Background="#172A29" CornerRadius="7" Padding="10"><TextBlock Text="POST /heart-rate · Bearer 验证" FontSize="10" Foreground="#9AD7C6"/></Border><Button Content="复制本地推送示例" Click="CopyPush_Click" Margin="0,10,0,0"/><CheckBox x:Name="LanBox" Content="允许局域网设备推送" Checked="Lan_Changed" Unchecked="Lan_Changed"/><TextBlock Text="局域网模式仅用于可信网络；接收地址见接入指南。不要将端口映射到公网。" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="17"/></StackPanel>
       </StackPanel>
       <StackPanel Grid.Row="2" Margin="0,19,0,0">
        <Border Background="#2A2234" CornerRadius="9" Padding="12" Margin="0,0,0,13"><TextBlock x:Name="ConnectionMessage" Text="就绪 · 选择数据源后连接" TextWrapping="Wrap" Foreground="#C2AECF" FontSize="11" LineHeight="18"/></Border>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ConnectButton" Content="连接设备  →" Style="{StaticResource PrimaryButton}" Click="Connect_Click"/><Button x:Name="StopButton" Grid.Column="2" Content="断开" Click="Stop_Click" IsEnabled="False"/></Grid>
        <Border Height="1" Background="#3B2D45" Margin="0,20,0,15"/>
        <Grid><TextBlock Text="本次会话" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="SessionTime" Text="00:00:00" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="#D5C8DE" FontSize="12"/></Grid>
        <Button Content="导出会话 CSV  ↓" Click="Export_Click" Background="Transparent" BorderThickness="0" Foreground="#BEA7CE" Padding="0,13,0,0" HorizontalAlignment="Left" FontSize="11"/>
       </StackPanel>
      </Grid>
     </Border>
    </Grid>
    <Border x:Name="SyncCard" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="22,19">
     <StackPanel>
      <Grid><StackPanel Orientation="Horizontal"><Border Width="28" Height="28" Background="#20372F" CornerRadius="8" Margin="0,0,10,0"><Path Data="{StaticResource SyncIcon}" Stroke="#9DDAC8" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/></Border><TextBlock Text="状态同步" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="02 / OUTPUT" Foreground="#9A829F" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
      <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="336"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="输出模板 · 支持 {bpm} 和 {source}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,9"/><TextBox x:Name="TemplateBox" Text="♥ {bpm} BPM" MaxLength="120" TextChanged="Template_Changed" AutomationProperties.Name="状态输出模板"/><StackPanel Orientation="Horizontal" Margin="0,11,0,0"><TextBlock Text="预览" Foreground="#9F8AAA" FontSize="9" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock x:Name="PreviewText" Text="♥ -- BPM · 未连接" Foreground="#F3B5D0" FontSize="12" TextWrapping="Wrap"/></StackPanel></StackPanel>
       <StackPanel Grid.Column="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="复制状态命令" Click="CopyCommand_Click" Background="#382A40" Foreground="#F7C6DF"/><Button Grid.Column="2" Content="输出文件夹 ↗" Click="Folder_Click"/></Grid><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><CheckBox x:Name="OscBox" Content="同步 VRChat Chatbox" Checked="Osc_Changed" Unchecked="Osc_Changed"/><TextBox x:Name="OscPortBox" Text="9000" Width="58" Height="29" Padding="6,5" Margin="12,0,0,0" ToolTip="本机 OSC UDP 端口，默认 9000" LostFocus="Port_Changed" AutomationProperties.Name="OSC 端口"/></StackPanel><TextBlock Text="默认关闭 · 每 5 秒发送 · 需在 VRChat 中启用 OSC" Foreground="#9F8AAA" FontSize="9" TextWrapping="Wrap"/></StackPanel>
      </Grid>
     </StackPanel>
    </Border>
    <TextBlock x:Name="Footer" Text="●  本地接口启动中…     ·     心率趋势仅用于展示，不是心电图。" Foreground="#98839F" FontSize="9" Margin="2,16,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>


